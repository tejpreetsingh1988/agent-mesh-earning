# Copy to .env — never commit a real key
# OpenRouter key for the LLM story layer only (Writer prose, validated).
# Without it, briefings still work — the story is deterministic.
# Get a key at https://openrouter.ai/keys (sign-up is free, no card
# for :free models). Never paste a key in chat or into a zip.
OPENROUTER_API_KEY=
LLM_MODEL_PRIMARY=nvidia/nemotron-3-ultra-550b-a55b:free
# Fallback chain, in order (Oct 29, 2026: Super :free is gone, 404 paid-only — do not use it).
LLM_MODEL_FALLBACKS=google/gemma-4-31b-it:free,cohere/north-mini-code:free
LLM_API_KEY=
EDGAR_USER_AGENT=agent-mesh-earnings dev contact@example.com
# Free Alpha Vantage key for live consensus EPS (25 calls/day free tier).
# Without it, get_consensus_estimates returns the GOOGL Q3 2026 range only,
# and 'unavailable' for other tickers. Get a key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# Bearer token for agent/MCP endpoints. Empty = auth off (local dev).
# Set a long random value to require Authorization: Bearer <token>.
AGENT_API_TOKEN=
